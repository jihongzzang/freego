{
  "expo": {
    "name": "Freego Dev",
    "slug": "freego-app-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freego-dev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "locales": {
        "ko": {
          "label": "프리고"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frigo.app.dev",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleLocalizations": ["ko", "en", "ja"],
        "CFBundleDisplayName": "프리고"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
